# Preserve the exact audited dependency bytes and their SHA256 provenance.
assets/vendor/openpgp/* -text
# Installer seeds are verified byte-for-byte on each platform.
ZIP/PLZ*.csv -text

# The installation bundle can be built in Git Bash on Windows.
ops/install-ubuntu-22.04.sh text eol=lf
ops/production/build-ubuntu-installer.sh text eol=lf
ops/production/ubuntu-installer-wrapper.sh.in text eol=lf
tests/production_package_test.sh text eol=lf

# Retired admin scripts are kept for source history only.
/admin/auction-disputes.php export-ignore
/admin/global-logout.php export-ignore
/admin/messages.php export-ignore
/admin/verify-queue.php export-ignore
