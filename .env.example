# Inject through process manager; no automatic dotenv loader.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
SESSION_COOKIE_SECURE=1
APP_KEY=
AUTH_RATE_LIMIT_DIR=/var/lib/gunindex/limits
GENERAL_IMAGE_DIR=/var/lib/gunindex/images
APP_URL=
PAYPAL_MODE=sandbox
PAYPAL_ACCOUNT_TYPE=personal
PAYPAL_ENABLED=0
PLATFORM_BILLING_APPROVED=0
PAYPAL_LIVE_APPROVED=0
PAYPAL_REFUNDS_ENABLED=0
PAYPAL_REFUNDS_LIVE_APPROVED=0
PAYPAL_BUSINESS_SCOPE=general_only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
BANK_TRANSFER_ENABLED=0
BANK_TRANSFER_APPROVED=0
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BENEFICIARY=
BITCOIN_ENABLED=0
BITCOIN_LIVE_APPROVED=0
BITCOIN_NETWORK=regtest
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_WALLET=
BITCOIN_RATE_CENTS=
BITCOIN_RATE_UNTIL=
BITCOIN_CONFIRMATIONS=6

# Server-side AEAD encryption; keep the previous key during a documented rotation.
APP_KEY_PREVIOUS=
GENERAL_PRIVATE_DIR=/var/lib/gunindex/private
APP_ENV=production
# Disabled until the E2EE deployment and application security review are complete.
E2EE_ENABLED=0
E2EE_ATTACHMENT_DIR=/var/lib/gunindex/e2ee
# Local MTA delivery: switch to sendmail only after DNS and real delivery checks.
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_QUEUE_RETENTION_DAYS=7
