# Inject through process manager; no automatic dotenv loader.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
SESSION_COOKIE_SECURE=1
APP_KEY=
AUTH_RATE_LIMIT_DIR=/var/lib/gunindex/limits
GENERAL_IMAGE_DIR=/var/lib/gunindex/images
APP_URL=
PAYPAL_MODE=sandbox
PAYPAL_ACCOUNT_TYPE=personal
PAYPAL_ENABLED=0
PLATFORM_BILLING_APPROVED=0
PAYPAL_LIVE_APPROVED=0
PAYPAL_BUSINESS_SCOPE=general_only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
